{
  "lexicon": 1,
  "id": "org.connectsensors.trust",
  "description": "A published trust statement about another participant (spec 10 section 5). Exactly one of subjectDid and subjectPubkey MUST be present.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["action", "createdAt"],
        "properties": {
          "subjectDid": { "type": "string", "format": "did" },
          "subjectPubkey": { "type": "string", "minLength": 64, "maxLength": 64, "description": "Nostr public key, 64 lowercase hex digits." },
          "action": { "type": "string", "knownValues": ["allowDownlinks", "block", "profileSource"] },
          "note": { "type": "string", "maxLength": 300 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
